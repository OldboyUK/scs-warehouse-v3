import { Context } from '@netlify/types';

interface HandlerContext {
    callbackWaitsForEmptyEventLoop: boolean;
    functionName: string;
    functionVersion: string;
    invokedFunctionArn: string;
    memoryLimitInMB: string;
    awsRequestId: string;
    logGroupName: string;
    logStreamName: string;
    identity?: Record<string, unknown>;
    clientContext?: Record<string, unknown>;
    getRemainingTimeInMillis(): number;
    /** @deprecated Use handler callback or promise result */
    done(error?: Error, result?: unknown): void;
    /** @deprecated Use handler callback with first argument or reject a promise result */
    fail(error: Error | string): void;
    /** @deprecated Use handler callback with second argument or resolve a promise result */
    succeed(messageOrObject: unknown): void;
    /** @deprecated Use handler callback or promise result */
    succeed(message: string, object: unknown): void;
}

type EventHeaders = Record<string, string | undefined>;
type EventMultiValueHeaders = Record<string, string[] | undefined>;
type EventQueryStringParameters = Record<string, string | undefined>;
type EventMultiValueQueryStringParameters = Record<string, string[] | undefined>;
interface HandlerEvent {
    rawUrl: string;
    rawQuery: string;
    path: string;
    httpMethod: string;
    headers: EventHeaders;
    multiValueHeaders: EventMultiValueHeaders;
    queryStringParameters: EventQueryStringParameters | null;
    multiValueQueryStringParameters: EventMultiValueQueryStringParameters | null;
    body: string | null;
    isBase64Encoded: boolean;
    route?: string;
}

interface HandlerResponse {
    statusCode: number;
    headers?: Record<string, boolean | number | string>;
    multiValueHeaders?: Record<string, readonly (boolean | number | string)[]>;
    body?: string;
    isBase64Encoded?: boolean;
}

type HandlerCallback<ResponseType extends HandlerResponse = HandlerResponse> = (error: unknown, response: ResponseType) => void;
type Handler = (event: HandlerEvent, context: HandlerContext, callback?: HandlerCallback) => undefined | Promise<HandlerResponse>;

type LambdaHandler = (event: HandlerEvent, context: HandlerContext) => Promise<HandlerResponse> | HandlerResponse;
declare function withLambda(handler: LambdaHandler): (request: Request, context: Context) => Promise<Response>;

export { type Handler, type HandlerCallback, type HandlerContext, type HandlerEvent, type HandlerResponse, type LambdaHandler, withLambda };
